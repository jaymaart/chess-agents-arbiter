# =============================================================================
# AgentChess Sandbox — Minimal multi-runtime container for untrusted agents
# Runtimes: deno (default for JS since Season 3), node (fallback), python3
#
# Debian slim (not alpine): the official deno binary is glibc-linked.
# =============================================================================

# Pin Deno so image rebuilds don't drift onto the newest 2.x patch. Deno 2.9.2
# shipped a runtime panic that crashed JS agents mid-match; tracking `:bin`
# (latest) silently pulled it in. Bump DENO_VERSION once a newer release is
# verified stable. Keep in lockstep with the root Dockerfile.
ARG DENO_VERSION=2.8.3
FROM denoland/deno:bin-${DENO_VERSION} AS deno

FROM node:22-slim

# Deno — deny-by-default runtime for JS agents (deno run --no-prompt).
# Version pinned via DENO_VERSION (see the `deno` stage at the top of this file).
COPY --from=deno /deno /usr/local/bin/deno

# Python 3 runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

# Legacy: chess.js on NODE_PATH for pre-fortress-gate engines run under node.
# The current validation allowlist only permits require("readline"), and deno
# ignores NODE_PATH — safe to drop once no grandfathered engines remain.
RUN npm install -g chess.js && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV NODE_PATH=/usr/local/lib/node_modules

# Create non-root user
RUN useradd -m -s /bin/sh agent

USER agent
WORKDIR /tmp

# No entrypoint — container runs `sleep infinity` and we `docker exec` into it
